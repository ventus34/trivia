{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trivia",
  "version": "0.1.0",
  "identifier": "io.github.ventus34.trivia",
  "build": {
    "beforeDevCommand": {
      "script": "npm run build:desktop",
      "wait": true
    },
    "beforeBuildCommand": "npm run build:desktop",
    "frontendDist": "../dist-desktop"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Trivia",
        "width": 1100,
        "height": 780,
        "minWidth": 360,
        "minHeight": 520,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost; base-uri 'none'; object-src 'none'; frame-src 'none'; form-action 'none'",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "category": "Game",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
